#!/bin/sh
# Git pre-commit hook to automatically format staged Python files with ruff.

# Find staged Python files (excluding deleted files)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=d | grep '\.py$')

if [ -n "$STAGED_PY_FILES" ]; then
    echo "Running ruff format on staged Python files..."

    # Find ruff binary (check venv first, then system PATH)
    if [ -f "venv/bin/ruff" ]; then
        RUFF="venv/bin/ruff"
    elif command -v ruff >/dev/null 2>&1; then
        RUFF="ruff"
    else
        echo "Error: ruff not found in venv/bin/ruff or system PATH."
        echo "Please install dependencies: pip install -r requirements-dev.txt"
        exit 1
    fi

    # Format staged files
    $RUFF format $STAGED_PY_FILES
    FORMAT_STATUS=$?

    if [ $FORMAT_STATUS -ne 0 ]; then
        echo "Error: ruff format failed."
        exit 1
    fi

    # Re-stage the formatted files
    git add $STAGED_PY_FILES
    echo "Ruff formatting applied and staged successfully."
fi

exit 0
