# Bomb Crypto Automation Bot - Environment Configuration Template
# Copy this file to .env and customize values for your local environment

# ==========================================
# 1. GAME VERSION & LANDING CONFIGURATION
# ==========================================
# Game version: v13d (direct treasure landing) or v10l (requires clicking treasure hunt button after refresh/login)
GAME_VERSION=v13d

# Direct game URL (Auto-selected based on GAME_VERSION if omitted)
# v13d: https://game.bombcrypto.io/web/v13d/index.html?landing=treasure
# v10l: https://game.bombcrypto.io/web/v10l/index.html
# DIRECT_TREASURE_URL=https://game.bombcrypto.io/web/v13d/index.html?landing=treasure

# Direct landing mode (auto-set based on GAME_VERSION if omitted: true for v13d, false for v10l)
# DIRECT_LANDING_MODE=true

# Target browser to attach/launch: brave, chrome, firefox, edge, opera, vivaldi, default
TARGET_BROWSER=brave

# Optional: Absolute path to custom browser binary executable
# BROWSER_EXECUTABLE_PATH=/opt/brave.com/brave/brave

# Auto-launch browser if not already running
AUTO_LAUNCH_BROWSER=true

# ==========================================
# 2. VISION & DISPLAY CONFIGURATION
# ==========================================
# Default template matching confidence threshold (0.0 to 1.0)
DEFAULT_MATCH_THRESHOLD=0.70

# Monitor index to capture: 1 for primary monitor, 0 for all combined
SCREENSHOT_MONITOR_INDEX=1

# Save visual debug screenshots (debug_last_screen.png and debug_last_match.png)
SAVE_DEBUG_IMAGES=true

# ==========================================
# 3. ANTI-DETECTION & HUMANIZATION
# ==========================================
# Random mouse click offset from button center (in pixels)
MOUSE_CLICK_OFFSET=5

# Mouse movement duration range (in seconds, lower = faster mouse movement)
MIN_CLICK_DURATION=0.08
MAX_CLICK_DURATION=0.20

# Delay between UI clicks (in seconds)
MIN_ACTION_DELAY=1.0
MAX_ACTION_DELAY=2.5

# Enable cubic Bézier mouse movement curves
USE_BEZIER_CURVES=true
BEZIER_MIN_STEPS=5

# Enable Gaussian delay distribution
USE_GAUSSIAN_DELAYS=true

# Enable anti-AFK idle mouse jitter while resting
ENABLE_IDLE_JITTER=true
IDLE_JITTER_INTERVAL_SECONDS=30
IDLE_JITTER_MAX_OFFSET=15

# ==========================================
# 4. BOT TIMERS & INNER BOT MODES
# ==========================================
# Hero work cycle interval (in minutes)
HERO_WORK_INTERVAL_MINUTES=30

# Frequency to scan for game errors and disconnect popups (in seconds)
ERROR_CHECK_INTERVAL_SECONDS=15

# Maximum minutes without state progression before anti-stuck page refresh
MAX_STUCK_TIMEOUT_MINUTES=10

# Inner Bot Mode 1: Only refresh browser page when game error popups are detected
ONLY_REFRESH_ON_ERROR=false

# Inner Bot Mode 2: Periodic page refresh interval in minutes (0.0 = disabled)
REFRESH_INTERVAL_MINUTES=0.0

# Enable manual hero menu work clicking (set to false when using inner bot)
ENABLE_HERO_WORK_ACTIONS=true

# Hero work selection mode: 'stamina' (default, sends heroes with stamina) or 'all'
HERO_WORK_MODE=stamina

# Send only heroes with stamina to work (default: true)
WORK_ONLY_STAMINA=true

# Minimum stamina percentage threshold to send hero to work (default: 60)
HERO_MIN_STAMINA=60

# ==========================================
# 5. NOTIFICATION SERVICES
# ==========================================
ENABLE_NOTIFICATIONS=true

# Discord Webhook URL for bot alerts
DISCORD_WEBHOOK_URL=

# Telegram Bot Token & Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 6. SIMULATION / DRY RUN
# ==========================================
# Set to true to simulate matching without physical mouse clicking
DRY_RUN=false
